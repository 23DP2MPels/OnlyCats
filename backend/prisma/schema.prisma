generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  SUSPENDED
  EXPIRED
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String
  passwordHash String
  role         Role           @default(USER)
  createdAt    DateTime       @default(now())
  cats         Cat[]
  subscriptions Subscription[]
  likes         Like[]
  comments      Comment[]
  earnings      OwnerPayment[]
  withdrawals   WithdrawalRequest[]
  loginEvents   LoginEvent[]
}

model Cat {
  id          String         @id @default(uuid())
  name        String
  breed       String
  bio         String
  avatar      String         @default("/cats/marmalade.svg")
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id])
  createdAt   DateTime       @default(now())
  posts       Post[]
  subscriptions Subscription[]
  earnings      OwnerPayment[]
  @@index([ownerId])
}

model Post {
  id        String   @id @default(uuid())
  title     String
  body      String
  isPrivate Boolean  @default(false)
  imageKey  String?
  catId     String
  cat       Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  likes     Like[]
  comments  Comment[]
  @@index([catId, createdAt])
}

model Like {
  userId String
  postId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, postId])
  @@index([postId])
}

model Comment {
  id String @id @default(uuid())
  body String
  userId String
  postId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([postId, createdAt])
}

model Subscription {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  catId        String
  cat          Cat                @relation(fields: [catId], references: [id])
  paypalId     String?            @unique
  checkoutKey  String             @default(uuid())
  status       SubscriptionStatus @default(PENDING)
  paidUntil    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  payments     OwnerPayment[]
  @@unique([userId, catId])
}

model WebhookEvent {
  id          String   @id
  processedAt DateTime @default(now())
}

model StoredImage {
  id String @id @default(uuid())
  data Bytes
  createdAt DateTime @default(now())
}

enum WithdrawalStatus {
  PENDING
  CANCELLED
}

model OwnerPayment {
  id                    String @id @default(uuid())
  paypalTransactionId   String @unique
  paypalSubscriptionId  String
  subscriptionId        String
  subscription          Subscription @relation(fields: [subscriptionId], references: [id])
  ownerId               String
  owner                 User @relation(fields: [ownerId], references: [id])
  catId                 String
  cat                   Cat @relation(fields: [catId], references: [id])
  amountCents           Int
  currency              String @default("USD")
  status                String
  paidAt                DateTime
  createdAt             DateTime @default(now())
  @@index([ownerId, paidAt])
}

model WithdrawalRequest {
  id          String @id @default(uuid())
  requestId   String @unique
  ownerId     String
  owner       User @relation(fields: [ownerId], references: [id])
  amountCents Int
  currency    String @default("USD")
  status      WithdrawalStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([ownerId, createdAt])
}

model LoginEvent {
  id          String @id @default(uuid())
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  @@index([userId, createdAt])
}
